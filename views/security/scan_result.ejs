<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Scan Result - Security</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
      .result-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      }
      .success-card {
        border-left: 5px solid #28a745;
      }
      .error-card {
        border-left: 5px solid #dc3545;
      }
      .ticket-details {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 20px;
      }
      .action-buttons {
        margin-top: 20px;
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container">
        <a class="navbar-brand" href="/security/scan">
          <i class="bi bi-arrow-left me-2"></i>
          <i class="bi bi-qr-code-scan me-2"></i>
          Scan Result
        </a>
        <div class="navbar-nav ms-auto">
          <span class="navbar-text me-3">
            <i class="bi bi-shield-check me-1"></i>
            <%= security.firstName %> <%= security.lastName %>
          </span>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <div class="row justify-content-center">
        <div class="col-md-8">
          <% if (success) { %>
            <!-- Success Result -->
            <div class="card result-card success-card">
              <div class="card-header bg-success text-white">
                <h4 class="mb-0">
                  <i class="bi bi-check-circle me-2"></i>
                  Access Granted
                </h4>
              </div>
              <div class="card-body">
                <div class="text-center mb-4">
                  <i class="bi bi-check-circle display-1 text-success"></i>
                  <h3 class="text-success mt-3">VALID TICKET</h3>
                  <p class="lead"><%= message %></p>
                </div>

                <% if (ticket) { %>
                  <div class="ticket-details">
                    <h5 class="mb-3">Ticket Information</h5>
                    <div class="row">
                      <div class="col-md-6">
                        <strong>Attendee:</strong><br>
                        <%= ticket.first_name %> <%= ticket.last_name %>
                      </div>
                      <div class="col-md-6">
                        <strong>Student Number:</strong><br>
                        <%= ticket.student_number %>
                      </div>
                    </div>
                    <hr>
                    <div class="row">
                      <div class="col-md-6">
                        <strong>Event:</strong><br>
                        <%= ticket.event_title %>
                      </div>
                      <div class="col-md-6">
                        <strong>Venue:</strong><br>
                        <%= ticket.venue %>
                      </div>
                    </div>
                    <hr>
                    <div class="row">
                      <div class="col-md-6">
                        <strong>Ticket ID:</strong><br>
                        #<%= ticket.id %>
                      </div>
                      <div class="col-md-6">
                        <strong>Scanned At:</strong><br>
                        <%= new Date(ticket.scanned_at).toLocaleString() %>
                      </div>
                    </div>
                  </div>
                <% } %>

                <div class="action-buttons text-center">
                  <a href="/security/scan" class="btn btn-primary me-2">
                    <i class="bi bi-qr-code-scan me-1"></i>Scan Another
                  </a>
                  <a href="/security/dashboard" class="btn btn-outline-secondary">
                    <i class="bi bi-house me-1"></i>Dashboard
                  </a>
                </div>
              </div>
            </div>
          <% } else { %>
            <!-- Error Result -->
            <div class="card result-card error-card">
              <div class="card-header bg-danger text-white">
                <h4 class="mb-0">
                  <i class="bi bi-x-circle me-2"></i>
                  Access Denied
                </h4>
              </div>
              <div class="card-body">
                <div class="text-center mb-4">
                  <i class="bi bi-x-circle display-1 text-danger"></i>
                  <h3 class="text-danger mt-3">INVALID TICKET</h3>
                  <p class="lead text-danger"><%= error %></p>
                </div>

                <% if (ticket) { %>
                  <div class="ticket-details">
                    <h5 class="mb-3">Ticket Details</h5>
                    <div class="row">
                      <div class="col-md-6">
                        <strong>Attendee:</strong><br>
                        <%= ticket.first_name %> <%= ticket.last_name %>
                      </div>
                      <div class="col-md-6">
                        <strong>Student Number:</strong><br>
                        <%= ticket.student_number %>
                      </div>
                    </div>
                    <hr>
                    <div class="row">
                      <div class="col-md-6">
                        <strong>Event:</strong><br>
                        <%= ticket.event_title %>
                      </div>
                      <div class="col-md-6">
                        <strong>Status:</strong><br>
                        <span class="badge bg-warning"><%= ticket.status %></span>
                      </div>
                    </div>
                    <% if (ticket.status === 'scanned') { %>
                      <div class="alert alert-warning mt-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        This ticket was already scanned at: <%= new Date(ticket.scanned_at).toLocaleString() %>
                      </div>
                    <% } %>
                  </div>
                <% } %>

                <div class="action-buttons text-center">
                  <a href="/security/scan" class="btn btn-primary me-2">
                    <i class="bi bi-qr-code-scan me-1"></i>Try Again
                  </a>
                  <a href="/security/dashboard" class="btn btn-outline-secondary">
                    <i class="bi bi-house me-1"></i>Dashboard
                  </a>
                </div>

                <div class="mt-4 alert alert-info">
                  <h6><i class="bi bi-info-circle me-2"></i>Possible Reasons:</h6>
                  <ul class="mb-0">
                    <li>Ticket has already been used</li>
                    <li>Event has been cancelled</li>
                    <li>Invalid QR code</li>
                    <li>Ticket not properly assigned</li>
                  </ul>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
      // Auto-redirect to scanner after 10 seconds
      setTimeout(() => {
        window.location.href = '/security/scan';
      }, 10000);

      // Keyboard shortcuts
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          window.location.href = '/security/scan';
        } else if (e.key === 'Escape') {
          window.location.href = '/security/dashboard';
        }
      });
    </script>
  </body>
</html>