<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Security Dashboard</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
      .security-header {
        background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
      }
      .quick-action-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: none;
        border-radius: 10px;
      }
      .quick-action-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark security-header">
      <div class="container">
        <a class="navbar-brand" href="#">
          <i class="bi bi-shield-check me-2"></i>
          Security Portal
        </a>
        <div class="navbar-nav ms-auto">
          <span class="navbar-text me-3">
            Welcome, <%= security.firstName %> <%= security.lastName %>
          </span>
          <a class="btn btn-outline-light btn-sm" href="/security/logout">
            <i class="bi bi-box-arrow-right me-1"></i>Logout
          </a>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <div class="row">
        <div class="col-12">
          <h2>Security Dashboard</h2>
          <p class="text-muted">Quick access to security tools and assigned events</p>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="row mt-4">
        <div class="col-md-4 mb-3">
          <div class="card quick-action-card bg-primary text-white">
            <div class="card-body text-center">
              <i class="bi bi-qr-code-scan display-4 mb-3"></i>
              <h5>Scan Ticket</h5>
              <p class="mb-3">Scan QR codes to validate tickets</p>
              <a href="/security/scan" class="btn btn-light">Start Scanning</a>
            </div>
          </div>
        </div>

        <div class="col-md-4 mb-3">
          <div class="card quick-action-card bg-success text-white">
            <div class="card-body text-center">
              <i class="bi bi-list-task display-4 mb-3"></i>
              <h5>Event Tickets</h5>
              <p class="mb-3">View tickets for assigned events</p>
              <a href="/security/events" class="btn btn-light">View Events</a>
            </div>
          </div>
        </div>

        <div class="col-md-4 mb-3">
          <div class="card quick-action-card bg-info text-white">
            <div class="card-body text-center">
              <i class="bi bi-clock-history display-4 mb-3"></i>
              <h5>Scan History</h5>
              <p class="mb-3">View recent scanning activity</p>
              <a href="/security/history" class="btn btn-light">View History</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Placeholder for future content -->
      <div class="row mt-5">
        <div class="col-12">
          <div class="card">
            <div class="card-header">
              <h5 class="mb-0">Security Information</h5>
            </div>
            <div class="card-body">
              <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Welcome to the Security Portal!</strong><br>
                This is your main dashboard. Use the quick action cards above to access different security functions.
                More features will be added as we continue development.
              </div>
              
              <div class="row">
                <div class="col-md-6">
                  <h6>Your Security Details:</h6>
                  <ul class="list-unstyled">
                    <li><strong>Name:</strong> <%= security.firstName %> <%= security.lastName %></li>
                    <li><strong>Security ID:</strong> <%= security.identifier %></li>
                    <li><strong>Role:</strong> Security Personnel</li>
                  </ul>
                </div>
                <div class="col-md-6">
                  <h6>Quick Tips:</h6>
                  <ul>
                    <li>Use the Scan Ticket feature to validate QR codes</li>
                    <li>Ensure you have good lighting when scanning</li>
                    <li>Report any issues to your supervisor</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
      crossorigin="anonymous"
    ></script>
  </body>
</html>