<header id="header">
    <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(135deg, var(--primary-red) 0%, var(--dark-red) 100%);">
        <div class="container-fluid">
            <a class="navbar-brand mx-3" href="/admin/dashboard">
                <img
                    src="/include/images/logo.png"
                    alt="Logo"
