NODE_ENV=development
PORT=4000
# postgres://USER:PASSWORD@HOST:PORT/DB — URL-encode special characters in the password (e.g. # becomes %23)
DATABASE_URL=postgres://postgres:password@localhost:5432/spu_events
WEB_ORIGIN=http://localhost:5173
# Signs the session cookie. Generate one: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-random-hex-characters-0000000000000000
# Signs ticket QR codes (generate like SESSION_SECRET). Changing it invalidates every issued ticket QR.
TICKET_SIGNING_SECRET=replace-with-64-random-hex-characters-1111111111111111
# Separate database used by npm test. Tests wipe it, so never point it at real data.
TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/spu_events_test
# Where uploaded images are stored on this machine (relative to apps/api)
UPLOADS_DIR=uploads
# disk (UPLOADS_DIR) or database (Postgres; for hosts whose disk is wiped on deploy, like Render)
STORAGE=disk
# Production only: serve the built web app from the API, on one origin
# WEB_DIST_DIR=../web/dist
# When set, `npm run db:setup` (and `release` on deploy) seeds an EMPTY database with demo data;
# the demo accounts (admin@spuevents.demo, gate@spuevents.demo, student 202312345) use this password
# (at least 10 characters, like any account password).
# It also turns on the "Try as student / gate staff / admin" buttons on the login page.
# DEMO_PASSWORD=
# Public demos only: wipe the WHOLE database and re-seed once the demo data is this many hours old.
# DEMO_RESET_HOURS=6
LOG_LEVEL=info
