NODE_ENV=development
PORT=4000
# postgres://USER:PASSWORD@HOST:PORT/DB — URL-encode special characters in the password (e.g. # becomes %23)
DATABASE_URL=postgres://postgres:password@localhost:5432/monthati
WEB_ORIGIN=http://localhost:5173
# Signs the session cookie. Generate one: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-random-hex-characters-0000000000000000
# Signs ticket QR codes (generate like SESSION_SECRET). Changing it invalidates every issued ticket QR.
TICKET_SIGNING_SECRET=replace-with-64-random-hex-characters-1111111111111111
# Separate database used by npm test. Tests wipe it, so never point it at real data.
TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/monthati_test
# Where uploaded images are stored on this machine (relative to apps/api)
UPLOADS_DIR=uploads
LOG_LEVEL=info
