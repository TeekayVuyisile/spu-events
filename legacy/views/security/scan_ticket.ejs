    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>

<script>
  class QRScanner {
    constructor() {
      this.videoElement = null;
      this.canvasElement = null;
      this.canvasContext = null;
      this.isScanning = false;
      this.stream = null;
      this.scanInterval = null;
    }

    async initialize() {
  try {
    console.log('🔍 Checking camera availability...');
    
    // Check if browser supports media devices
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      throw new Error('Camera API not supported in this browser');
    }

    // Check available cameras first
    let cameras = [];
    try {
      cameras = await navigator.mediaDevices.enumerateDevices();
      const videoCameras = cameras.filter(device => device.kind === 'videoinput');
      console.log('📹 Available cameras:', videoCameras);
      
      if (videoCameras.length === 0) {
        throw new Error('No video cameras found on this device');
      }
    } catch (enumError) {
      console.warn('Could not enumerate cameras:', enumError);
      // Continue anyway - some browsers don't support enumerateDevices
    }

    // Try different camera constraints
    const constraints = [
      { video: { facingMode: "environment" } }, // Back camera
      { video: { facingMode: "user" } },        // Front camera
      { video: true }                           // Any camera
    ];

    let stream = null;
    let lastError = null;

    // Try each constraint until one works
    for (const constraint of constraints) {
      try {
        console.log('🔄 Trying camera constraint:', constraint);
        stream = await navigator.mediaDevices.getUserMedia(constraint);
        console.log('✅ Camera access granted with constraint:', constraint);
        break;
      } catch (error) {
        lastError = error;
        console.log('❌ Camera constraint failed:', constraint, error.name);
      }
    }

    if (!stream) {
      throw lastError || new Error('Could not access any camera');
    }
    
    this.stream = stream;
    await this.setupVideoElement();
    this.setupCanvas();
    
    return true;
  } catch (error) {
    console.error('❌ Scanner initialization failed:', error);
    this.showError(error);
    return false;
  }
}

    setupVideoElement() {
      const readerDiv = document.getElementById('reader');
      readerDiv.innerHTML = `
        <video id="videoElement" autoplay playsinline muted 
               style="width: 100%; height: 300px; object-fit: cover; border-radius: 8px;"></video>
        <canvas id="canvasElement" style="display: none;"></canvas>
        <div class="scan-frame" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); 
              width: 200px; height: 200px; border: 2px solid #0d6efd; border-radius: 8px; pointer-events: none;"></div>
      `;
      
      this.videoElement = document.getElementById('videoElement');
      this.videoElement.srcObject = this.stream;
      
      // Wait for video to load
      return new Promise((resolve) => {
        this.videoElement.addEventListener('loadeddata', () => {
          resolve();
        });
      });
    }

    setupCanvas() {
      this.canvasElement = document.getElementById('canvasElement');
      this.canvasContext = this.canvasElement.getContext('2d', { willReadFrequently: true });
    }

    startScanning() {
      if (this.isScanning) return;
      
      this.isScanning = true;
      updateStatus('scanning', 'Scanning for QR codes...');
      document.getElementById('scanLine').style.display = 'block';
      
      // Start scanning loop
      this.scanInterval = setInterval(() => {
        this.scanFrame();
      }, 500); // Scan every 500ms
    }

    scanFrame() {
      if (!this.isScanning || !this.videoElement || this.videoElement.readyState !== this.videoElement.HAVE_ENOUGH_DATA) {
        return;
      }

      // Set canvas size to match video
      this.canvasElement.width = this.videoElement.videoWidth;
      this.canvasElement.height = this.videoElement.videoHeight;
      
      // Draw video frame to canvas
      this.canvasContext.drawImage(this.videoElement, 0, 0, this.canvasElement.width, this.canvasElement.height);
      
      // Get image data for QR code detection
      const imageData = this.canvasContext.getImageData(0, 0, this.canvasElement.width, this.canvasElement.height);
      
      // Try to detect QR code
      try {
        const code = jsQR(imageData.data, imageData.width, imageData.height, {
          inversionAttempts: "dontInvert",
        });

        if (code) {
          console.log('QR Code detected:', code.data);
          this.handleQRDetected(code.data);
        }
      } catch (error) {
        console.log('QR detection error (normal):', error);
      }
    }

    async handleQRDetected(qrData) {
      // Stop scanning temporarily
      this.stopScanning();
      
      // Show detected feedback
      updateStatus('scanning', 'QR Code detected! Processing...');
      
      // Process the QR code
      await processScan(qrData);
      
      // Restart scanning after delay if still supposed to be scanning
      setTimeout(() => {
        if (this.isScanning) {
          this.startScanning();
        }
      }, 3000);
    }

    stopScanning() {
      this.isScanning = false;
      if (this.scanInterval) {
        clearInterval(this.scanInterval);
        this.scanInterval = null;
      }
      updateStatus('ready', 'Scanner ready');
      document.getElementById('scanLine').style.display = 'none';
    }

    stop() {
      this.stopScanning();
      if (this.stream) {
        this.stream.getTracks().forEach(track => track.stop());
      }
      if (this.videoElement) {
        this.videoElement.srcObject = null;
      }
    }

    showError(error) {
  const readerDiv = document.getElementById('reader');
  let errorTitle = 'Camera Unavailable';
  let errorMessage = '';
  let showRetry = true;
  let showManual = true;

  if (error.name === 'NotAllowedError') {
    errorTitle = 'Camera Permission Required';
    errorMessage = `
      <p class="mb-3">Please allow camera access to scan QR codes:</p>
      <ol class="text-start mb-3">
        <li>Look for a camera permission prompt</li>
        <li>Click "Allow" or "Yes"</li>
        <li>Refresh the page and try again</li>
      </ol>
      <p class="text-muted">If you don't see a prompt, check your browser's address bar for a camera icon.</p>
    `;
  } else if (error.name === 'NotFoundError' || error.message.includes('No video cameras')) {
    errorTitle = 'No Camera Found';
    errorMessage = `
      <p class="mb-3">No camera was detected on this device.</p>
      <p class="mb-3">This could be because:</p>
      <ul class="text-start mb-3">
        <li>Your device doesn't have a camera</li>
        <li>Your camera is being used by another application</li>
        <li>Camera drivers need to be updated</li>
      </ul>
    `;
  } else if (error.name === 'NotSupportedError') {
    errorTitle = 'Browser Not Supported';
    errorMessage = `
      <p class="mb-3">Your browser doesn't support camera access.</p>
      <p class="mb-3">Please try using:</p>
      <ul class="text-start mb-3">
        <li><strong>Chrome</strong> or <strong>Firefox</strong> on Android</li>
        <li><strong>Safari</strong> on iOS 11+</li>
        <li><strong>Chrome</strong>, <strong>Edge</strong>, or <strong>Firefox</strong> on desktop</li>
      </ul>
    `;
    showRetry = false;
  } else if (error.name === 'NotReadableError') {
    errorTitle = 'Camera in Use';
    errorMessage = `
      <p class="mb-3">Your camera is currently being used by another application.</p>
      <p class="mb-3">Please:</p>
      <ol class="text-start mb-3">
        <li>Close other applications that might be using the camera</li>
        <li>Refresh this page</li>
        <li>Try again</li>
      </ol>
    `;
  } else {
    errorMessage = `<p class="mb-3">${error.message || 'An unknown error occurred'}</p>`;
  }

  readerDiv.innerHTML = `
    <div class="alert alert-warning text-center" style="margin: 0; border: none;">
      <i class="bi bi-camera-video-off display-4 d-block mb-3 text-warning"></i>
      <h4>${errorTitle}</h4>
      ${errorMessage}
      <div class="d-grid gap-2 col-md-8 mx-auto">
        ${showRetry ? `
          <button class="btn btn-primary" onclick="retryCameraAccess()">
            <i class="bi bi-arrow-clockwise me-2"></i>Try Again
          </button>
        ` : ''}
        ${showManual ? `
          <button class="btn btn-outline-secondary" onclick="enableManualMode()">
            <i class="bi bi-keyboard me-2"></i>Use Manual Entry
          </button>
        ` : ''}
        <button class="btn btn-outline-info" onclick="showCameraHelp()">
          <i class="bi bi-question-circle me-2"></i>Get Help
        </button>
      </div>
    </div>
  `;
  updateStatus('error', 'Camera unavailable');
}
  }

  // Global variables
  let scanner = null;
  let scanStats = {
    scannedToday: 0,
    totalScanned: 0,
    successRate: 100
  };
  // Retry camera access
async function retryCameraAccess() {
  console.log('🔄 Retrying camera access...');
  updateStatus('scanning', 'Retrying camera access...');
  
  // Clear the reader div
  const readerDiv = document.getElementById('reader');
  readerDiv.innerHTML = `
    <div class="text-center p-4 text-light">
      <div class="spinner-border text-light mb-3" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
      <p>Attempting to access camera...</p>
    </div>
  `;
  
  // Re-initialize scanner
  setTimeout(async () => {
    await initializeScanner();
  }, 1000);
}

// Show camera help
function showCameraHelp() {
  const helpHTML = `
    <div class="alert alert-info text-start">
      <h5><i class="bi bi-info-circle me-2"></i>Camera Access Help</h5>
      <hr>
      <h6>For Mobile Devices:</h6>
      <ul>
        <li>Ensure you're using <strong>Chrome</strong> or <strong>Safari</strong></li>
        <li>Allow camera permissions when prompted</li>
        <li>Make sure no other app is using the camera</li>
      </ul>
      
      <h6>For Desktop Computers:</h6>
      <ul>
        <li>Use <strong>Chrome</strong>, <strong>Edge</strong>, or <strong>Firefox</strong></li>
        <li>Ensure your webcam is connected and working</li>
        <li>Check browser settings for camera permissions</li>
      </ul>
      
      <h6>Common Solutions:</h6>
      <ul>
        <li>Refresh the page and try again</li>
        <li>Check browser settings for camera permissions</li>
        <li>Restart your browser</li>
        <li>Try using manual entry if camera continues to fail</li>
      </ul>
    </div>
  `;
  
  // Replace the reader content with help
  const readerDiv = document.getElementById('reader');
  readerDiv.innerHTML = helpHTML;
  
  // Add back button
  const backButton = document.createElement('div');
  backButton.className = 'text-center mt-3';
  backButton.innerHTML = `
    <button class="btn btn-secondary me-2" onclick="retryCameraAccess()">
      <i class="bi bi-arrow-clockwise me-1"></i>Try Camera Again
    </button>
    <button class="btn btn-primary" onclick="enableManualMode()">
      <i class="bi bi-keyboard me-1"></i>Use Manual Entry
    </button>
  `;
  readerDiv.appendChild(backButton);
}

  // Initialize scanner
  async function initializeScanner() {
    console.log('🚀 Initializing QR Scanner...');
    updateStatus('scanning', 'Initializing camera...');

    try {
      scanner = new QRScanner();
      const success = await scanner.initialize();
      
      if (success) {
        console.log('✅ Scanner initialized successfully');
        updateStatus('ready', 'Camera ready - Click Start to begin scanning');
        
        // Enable start button
        document.getElementById('startScanner').disabled = false;
        document.getElementById('scannerPlaceholder').style.display = 'none';
      } else {
        console.error('❌ Scanner initialization failed');
      }
    } catch (error) {
      console.error('❌ Scanner initialization error:', error);
      updateStatus('error', 'Initialization failed');
    }
  }

  // Start scanning
  function startScanner() {
    if (!scanner) {
      console.error('Scanner not initialized');
      return;
    }
    
    scanner.startScanning();
    document.getElementById('startScanner').disabled = true;
    document.getElementById('stopScanner').disabled = false;
  }

  // Stop scanning
  function stopScanner() {
    if (scanner) {
      scanner.stopScanning();
    }
    document.getElementById('startScanner').disabled = false;
    document.getElementById('stopScanner').disabled = true;
  }

  function enableManualMode() {
  console.log('🔄 Switching to manual entry mode');
  
  const scannerContainer = document.querySelector('.scanner-container');
  scannerContainer.innerHTML = `
    <div class="alert alert-success text-center">
      <i class="bi bi-keyboard display-4 d-block mb-3 text-success"></i>
      <h4>Manual Entry Mode</h4>
      <p class="mb-3">Enter the ticket ID from the physical ticket or email:</p>
    </div>
    
    <div class="manual-entry card border-success">
      <div class="card-body">
        <form id="manualForm">
          <div class="mb-4">
            <label for="ticketId" class="form-label fs-5">
              <strong>Ticket ID</strong>
            </label>
            <input 
              type="text" 
              class="form-control form-control-lg text-center fw-bold" 
              id="ticketId" 
              placeholder="Enter Ticket ID"
              required
              autofocus
              style="font-size: 1.4rem; letter-spacing: 2px;"
              pattern="[0-9]+"
              title="Please enter numbers only"
            >
            <div class="form-text text-center">
              <i class="bi bi-info-circle me-1"></i>
              The ticket ID is usually a number found on the ticket
            </div>
          </div>
          
          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-success btn-lg py-3 fw-bold">
              <i class="bi bi-check-circle me-2"></i>Validate Ticket
            </button>
            <button type="button" class="btn btn-outline-primary" onclick="retryCameraAccess()">
              <i class="bi bi-camera me-2"></i>Try Camera Scanner Again
            </button>
          </div>
        </form>
      </div>
    </div>
    
    <div class="mt-4 alert alert-info">
      <h6><i class="bi bi-lightbulb me-2"></i>Where to find the Ticket ID:</h6>
      <ul class="mb-0">
        <li>On the printed ticket</li>
        <li>In the confirmation email</li>
        <li>On the digital ticket in the attendee's phone</li>
        <li>From the event organizer</li>
      </ul>
    </div>
  `;
  
  // Re-attach manual form handler
  document.getElementById('manualForm').addEventListener('submit', handleManualSubmit);
  updateStatus('ready', 'Manual entry mode active');
  
  // Focus on the input field
  setTimeout(() => {
    const ticketInput = document.getElementById('ticketId');
    if (ticketInput) ticketInput.focus();
  }, 100);
}

  // Update status display
  function updateStatus(status, message) {
    const statusIndicator = document.getElementById('statusIndicator');
    const statusText = document.getElementById('statusText');
    const cameraStatus = document.getElementById('cameraStatus');
    
    // Status indicator colors
    const statusColors = {
      ready: 'bg-success',
      scanning: 'bg-warning',
      error: 'bg-danger'
    };
    
    if (statusIndicator) {
      statusIndicator.className = `status-indicator ${statusColors[status] || 'bg-secondary'}`;
    }
    if (statusText) {
      statusText.textContent = message;
    }
    if (cameraStatus) {
      cameraStatus.textContent = status === 'scanning' ? '📹 Camera active' : '📷 Camera ready';
    }
    
    console.log(`Status: ${status} - ${message}`);
  }

  // Process QR code data
  async function processScan(qrData) {
    console.log('🔍 Processing QR data:', qrData);
    updateStatus('scanning', 'Validating ticket...');

    try {
      const response = await fetch('/security/scan/process', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ qr_data: qrData })
      });

      if (!response.ok) {
        throw new Error(`Server error: ${response.status}`);
      }

      const result = await response.json();
      console.log('📋 Scan result:', result);

      if (result.success) {
        // Update stats
        scanStats.scannedToday++;
        scanStats.totalScanned++;
        updateStatsDisplay();
        
        // Redirect to success page
        const ticketData = encodeURIComponent(JSON.stringify(result.ticket));
        window.location.href = `/security/scan/result?success=true&message=${encodeURIComponent(result.message)}&ticket=${ticketData}`;
      } else {
        // Redirect to error page
        const ticketData = result.ticket ? encodeURIComponent(JSON.stringify(result.ticket)) : '';
        window.location.href = `/security/scan/result?success=false&error=${encodeURIComponent(result.error)}&ticket=${ticketData}`;
      }

    } catch (error) {
      console.error('❌ Scan processing error:', error);
      window.location.href = `/security/scan/result?success=false&error=${encodeURIComponent('Network error: ' + error.message)}`;
    }
  }

  // Handle manual form submission
  async function handleManualSubmit(e) {
    e.preventDefault();
    
    const ticketId = document.getElementById('ticketId').value.trim();
    if (!ticketId) {
      alert('Please enter a ticket ID');
      return;
    }

    if (!/^\d+$/.test(ticketId)) {
      alert('Please enter a valid numeric ticket ID');
      return;
    }

    // Create QR-like data structure for manual entry
    const qrData = JSON.stringify({
      ticket_id: parseInt(ticketId),
      user_id: 0,
      event_id: 0,
      timestamp: Date.now(),
      type: 'manual_entry'
    });

    await fetch('/security/scan/process', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ qrData })
});

  }

  // Load and display statistics
  function loadScanStats() {
    // Mock data - in real app, fetch from server
    scanStats = {
      scannedToday: Math.floor(Math.random() * 20) + 5,
      totalScanned: Math.floor(Math.random() * 200) + 50,
      successRate: 95
    };
    updateStatsDisplay();
  }

  function updateStatsDisplay() {
    document.getElementById('scannedToday').textContent = scanStats.scannedToday;
    document.getElementById('totalScanned').textContent = scanStats.totalScanned;
    document.getElementById('successRate').textContent = scanStats.successRate + '%';
  }

  // Initialize everything when page loads
  document.addEventListener('DOMContentLoaded', function() {
    console.log('🎬 Security Scanner Page Loading...');
    
    // Set up button listeners
    document.getElementById('startScanner').addEventListener('click', startScanner);
    document.getElementById('stopScanner').addEventListener('click', stopScanner);
    document.getElementById('manualForm').addEventListener('submit', handleManualSubmit);
    
    // Load statistics
    loadScanStats();
    
    // Auto-initialize scanner
    console.log('🔄 Auto-initializing scanner...');
    initializeScanner();
  });

  // Clean up when page closes
  window.addEventListener('beforeunload', function() {
    if (scanner) {
      scanner.stop();
    }
  });
  window.addEventListener('load', () => {
  initializeScanner();
});
</script>
  </body>
</html>
