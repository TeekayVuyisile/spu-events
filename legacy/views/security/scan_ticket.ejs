    <style>
      body {
        background: #f8f9fa;
      }
      .scanner-container {
        max-width: 100%;
        margin: 0 auto;
      }
      #reader {
        width: 100%;
        max-width: 500px;
        margin: 0 auto;
        border: 3px solid #0d6efd;
        border-radius: 10px;
        overflow: hidden;
      }
      .scanner-overlay {
        position: relative;
      }
      .scan-line {
        position: absolute;
        height: 3px;
        background: #0d6efd;
        width: 100%;
        top: 50%;
        animation: scan 2s infinite linear;
        box-shadow: 0 0 10px #0d6efd;
      }
      @keyframes scan {
        0% {
          top: 10%;
        }
        50% {
          top: 90%;
        }
        100% {
          top: 10%;
        }
      }
      .status-indicator {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 10px;
      }
      .status-ready {
        background-color: #28a745;
      }
      .status-scanning {
        background-color: #ffc107;
      }
      .status-error {
        background-color: #dc3545;
      }
      .manual-entry {
        background: white;
        border-radius: 10px;
        padding: 20px;
        margin-top: 20px;
      }
      .scan-sound {
        display: none;
      }
      .event-selector {
        max-width: 300px;
        margin: 0 auto 20px;
      }
      .scan-frame {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200px;
  height: 200px;
  border: 3px solid #0d6efd;
  border-radius: 10px;
  pointer-events: none;
  box-shadow: 0 0 0 1000px rgba(0, 0, 0, 0.3);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { border-color: #0d6efd; }
  50% { border-color: #0dcaf0; }
  100% { border-color: #0d6efd; }
}

.scanner-overlay {
  position: relative;
  overflow: hidden;
  border-radius: 10px;
}
