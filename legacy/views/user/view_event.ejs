<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= event.title %> - Campus Events</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.1/css/all.min.css">
    <style>
        :root {
            --primary-red: #dc3545;
            --dark-red: #c82333;
            --light-red: #f8d7da;
            --white: #ffffff;
            --light-gray: #f8f9fa;
            --dark-gray: #343a40;
        }
        
        body {
            background-color: var(--light-gray);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .navbar-brand {
            font-weight: bold;
            color: var(--primary-red) !important;
        }
        
        .nav-link.active {
            color: var(--primary-red) !important;
            font-weight: 600;
        }
        
        .event-hero {
            background: linear-gradient(135deg, var(--primary-red) 0%, var(--dark-red) 100%);
            color: var(--white);
            padding: 3rem 0;
            margin-bottom: 2rem;
        }
        
        .event-cover {
            height: 400px;
            background-size: cover;
            background-position: center;
            border-radius: 15px;
            position: relative;
        }
        
        .event-cover-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.4);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 3rem;
        }
        
        .event-details-card {
            background: var(--white);
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            padding: 2rem;
            margin-bottom: 2rem;
        }
        
        .action-card {
            background: var(--white);
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            padding: 1.5rem;
            margin-bottom: 2rem;
            border-top: 4px solid var(--primary-red);
        }
        
        .comment-card {
            background: var(--white);
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            padding: 1.5rem;
            margin-bottom: 1rem;
            border-left: 3px solid var(--primary-red);
        }
        
        .reply-card {
            background: var(--light-gray);
            border-radius: 8px;
            padding: 1rem;
            margin: 0.5rem 0 0.5rem 2rem;
            border-left: 2px solid #6c757d;
        }
        
        .like-btn {
            background: none;
            border: none;
            color: #6c757d;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .like-btn:hover {
            color: var(--primary-red);
        }
        
        .like-btn.liked {
            color: var(--primary-red);
        }
        
        .reaction-btn {
            background: none;
            border: none;
            color: #6c757d;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .reaction-btn:hover {
            color: var(--primary-red);
        }
        
        .reaction-btn.active-like {
            color: #28a745;
        }
        
        .reaction-btn.active-dislike {
            color: #dc3545;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, var(--primary-red) 0%, var(--dark-red) 100%);
            border: none;
            border-radius: 8px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
        }
        
        .btn-success {
            border-radius: 8px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
        }
        
        .btn-outline-primary {
            border-color: var(--primary-red);
            color: var(--primary-red);
            border-radius: 8px;
        }
        
        .btn-outline-primary:hover {
            background-color: var(--primary-red);
            border-color: var(--primary-red);
        }
        
        .text-red {
            color: var(--primary-red) !important;
        }
        
        .badge-red {
            background-color: var(--primary-red);
            color: white;
        }
        
        .comment-actions {
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        .comment-card:hover .comment-actions {
            opacity: 1;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="/user/dashboard">
          <img src="/include/images/logo.png" alt="" style="width: 40px; height: 40px;" /> Sol Plaatje Events
        </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/user/dashboard">
                            <i class="fas fa-home me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/user/events">
                            <i class="fas fa-calendar me-1"></i>Events
                        </a>
                    </li>
                     <li class="nav-item">
                        <a class="nav-link" href="/user/wallet">
                            <i class="fas fa-wallet me-1"></i>Wallet
                        </a>
                    </li>
                    <li class="nav-item">
    <a class="nav-link" href="/user/tickets">
        <i class="fas fa-ticket-alt me-1"></i>Tickets
    </a>
</li>
<li class="nav-item">
    <a class="nav-link" href="/user/notifications">
        <i class="fas fa-bell me-1"></i>Notifications
        <!-- You can add badge count later -->
        <!-- <span class="badge bg-danger">3</span> -->
    </a>
</li>
                    <li class="nav-item">
                        <a class="nav-link" href="/user/logout">
                            <i class="fas fa-sign-out-alt me-1"></i>Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Event Hero Section -->
    <div class="event-hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/user/dashboard" class="text-white">Dashboard</a></li>
                            <li class="breadcrumb-item"><a href="/user/events" class="text-white">Events</a></li>
                            <li class="breadcrumb-item active text-white" aria-current="page"><%= event.title %></li>
                        </ol>
                    </nav>
                    <h1 class="display-4 fw-bold"><%= event.title %></h1>
                    <p class="lead mb-0"><%= event.description ? event.description.substring(0, 150) + '...' : 'No description available' %></p>
                </div>
                <div class="col-md-4 text-md-end">
                    <div class="bg-white text-dark rounded-3 p-3 d-inline-block shadow">
                        <small class="text-muted">Your Wallet</small>
                        <div class="fw-bold text-success">$<%= parseFloat(wallet).toFixed(2) %></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <!-- Success/Error Messages -->
        <% if (success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i><%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        
        <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i><%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="row">
            <!-- Main Content -->
            <div class="col-lg-8">
                <!-- Event Cover Image -->
                <div class="event-cover mb-4" 
                     style="<%= event.cover_image ? 'background-image: url(\'' + event.cover_image + '\')' : 'background: linear-gradient(135deg, var(--primary-red) 0%, var(--dark-red) 100%)' %>">
                    <% if (!event.cover_image) { %>
                        <div class="event-cover-overlay">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                    <% } %>
                </div>

                <!-- Event Details -->
                <div class="event-details-card">
                    <h3 class="fw-bold mb-4">Event Details</h3>
                    
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p><strong><i class="fas fa-calendar me-2 text-red"></i>Date & Time:</strong><br>
                            <%= new Date(event.start_date_time).toLocaleDateString('en-US', { 
                                weekday: 'long', 
                                year: 'numeric', 
                                month: 'long', 
                                day: 'numeric' 
                            }) %><br>
                            <small class="text-muted">
                                <%= new Date(event.start_date_time).toLocaleTimeString('en-US', { 
                                    hour: '2-digit', 
                                    minute: '2-digit' 
                                }) %> - 
                                <%= new Date(event.end_date_time).toLocaleTimeString('en-US', { 
                                    hour: '2-digit', 
                                    minute: '2-digit' 
                                }) %>
                            </small>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p><strong><i class="fas fa-map-marker-alt me-2 text-red"></i>Venue:</strong><br>
                            <%= event.venue || 'To be announced' %></p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p><strong><i class="fas fa-ticket-alt me-2 text-red"></i>Entrance Fee:</strong><br>
                            <span class="badge <%= event.entrance_fee > 0 ? 'bg-warning' : 'bg-success' %> fs-6">
                                <%= event.entrance_fee > 0 ? `$${parseFloat(event.entrance_fee).toFixed(2)}` : 'FREE ENTRY' %>
                            </span>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p><strong><i class="fas fa-users me-2 text-red"></i>Attendees:</strong><br>
                            <span class="fs-5"><%= event.attendees_count || 0 %> people attending</span>
                            </p>
                        </div>
                    </div>

                    <% if (event.description) { %>
                        <div class="mb-4">
                            <h5>Description</h5>
                            <p class="text-muted" style="white-space: pre-line;"><%= event.description %></p>
                        </div>
                    <% } %>

                    <!-- Event Like Button -->
                    <div class="d-flex align-items-center">
                        <button class="like-btn <%= event.user_liked ? 'liked' : '' %> me-3" 
                                onclick="toggleEventLike(<%= event.id %>)">
                            <i class="fas fa-heart me-1"></i>
                            <span class="like-count"><%= event.likes_count || 0 %></span>
                        </button>
                        <small class="text-muted">Click to like this event</small>
                    </div>
                </div>

                <!-- Comments Section -->
<div class="event-details-card">
    <h3 class="fw-bold mb-4">
        <i class="fas fa-comments me-2 text-red"></i>Comments
        <span class="badge bg-primary ms-2" id="commentsCount"><%= comments.length %></span>
    </h3>

    <!-- Add Comment Form -->
    <form id="addCommentForm" class="mb-4">
        <input type="hidden" name="event_id" value="<%= event.id %>">
        <div class="mb-3">
            <label for="comment" class="form-label">Add a Comment</label>
            <textarea class="form-control" id="comment" name="comment" rows="3" 
                      placeholder="Share your thoughts about this event..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-paper-plane me-2"></i>Post Comment
        </button>
    </form>

    <!-- Comments List -->
    <div id="commentsList">
        <% if (comments.length > 0) { %>
            <% comments.forEach(comment => { %>
                <div class="comment-card" id="comment-<%= comment.id %>">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <strong><%= comment.first_name %> <%= comment.last_name %></strong>
                            <small class="text-muted ms-2">@<%= comment.identifier %></small>
                        </div>
                        <small class="text-muted"><%= new Date(comment.created_at).toLocaleString() %></small>
                    </div>
                    <p class="mb-2" id="comment-text-<%= comment.id %>"><%= comment.comment %></p>
                    
                    <div class="comment-actions d-flex gap-2 align-items-center">
                        <button class="reaction-btn <%= comment.user_liked ? 'active-like' : '' %>" 
                                onclick="toggleCommentReaction(<%= comment.id %>, 'like')">
                            <i class="fas fa-thumbs-up"></i> 
                            <span class="reaction-count" id="like-count-<%= comment.id %>"><%= comment.likes || 0 %></span>
                        </button>
                        
                        <button class="reaction-btn <%= comment.user_disliked ? 'active-dislike' : '' %>" 
                                onclick="toggleCommentReaction(<%= comment.id %>, 'dislike')">
                            <i class="fas fa-thumbs-down"></i> 
                            <span class="reaction-count" id="dislike-count-<%= comment.id %>"><%= comment.dislikes || 0 %></span>
                        </button>
                        
                        <button class="reaction-btn" onclick="showReplyForm(<%= comment.id %>)">
                            <i class="fas fa-reply"></i> Reply
                        </button>
                        
                        <% if (comment.user_id === user.id) { %>
                            <button class="reaction-btn" onclick="showEditForm(<%= comment.id %>, `<%= comment.comment.replace(/'/g, "\\'").replace(/"/g, '&quot;') %>`)">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                            <button class="reaction-btn text-danger" onclick="deleteComment(<%= comment.id %>)">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        <% } else { %>
                            <button class="reaction-btn text-danger" onclick="showReportModal(<%= comment.id %>)">
                                <i class="fas fa-flag"></i> Report
                            </button>
                        <% } %>
                    </div>

                    <!-- Reply Form (Hidden by default) -->
                    <div class="reply-form mt-3" id="replyForm-<%= comment.id %>" style="display: none;">
                        <form class="reply-form-inner" onsubmit="submitReply(event, <%= comment.id %>)">
                            <div class="mb-2">
                                <textarea class="form-control form-control-sm" name="reply" rows="2" 
                                          placeholder="Write a reply..." required></textarea>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary btn-sm">Post Reply</button>
                                <button type="button" class="btn btn-secondary btn-sm" 
                                        onclick="document.getElementById('replyForm-<%= comment.id %>').style.display = 'none'">
                                    Cancel
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Edit Form (Hidden by default) -->
                    <div class="edit-form mt-3" id="editForm-<%= comment.id %>" style="display: none;">
                        <form class="edit-form-inner" onsubmit="submitEdit(event, <%= comment.id %>)">
                            <div class="mb-2">
                                <textarea class="form-control form-control-sm" name="edit_comment" rows="3" required 
                                          id="edit-textarea-<%= comment.id %>"></textarea>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                                <button type="button" class="btn btn-secondary btn-sm" 
                                        onclick="document.getElementById('editForm-<%= comment.id %>').style.display = 'none'">
                                    Cancel
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Replies -->
                    <% if (comment.replies && comment.replies.length > 0) { %>
                        <div class="replies mt-3">
                            <% comment.replies.forEach(reply => { %>
                                <div class="reply-card" id="comment-<%= reply.id %>">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <strong><%= reply.first_name %> <%= reply.last_name %></strong>
                                            <small class="text-muted ms-2">@<%= reply.identifier %></small>
                                        </div>
                                        <small class="text-muted"><%= new Date(reply.created_at).toLocaleString() %></small>
                                    </div>
                                    <p class="mb-2" id="comment-text-<%= reply.id %>"><%= reply.comment %></p>
                                    
                                    <div class="comment-actions d-flex gap-2 align-items-center">
                                        <button class="reaction-btn <%= reply.user_liked ? 'active-like' : '' %>" 
                                                onclick="toggleCommentReaction(<%= reply.id %>, 'like')">
                                            <i class="fas fa-thumbs-up"></i> 
                                            <span class="reaction-count" id="like-count-<%= reply.id %>"><%= reply.likes || 0 %></span>
                                        </button>
                                        
                                        <button class="reaction-btn <%= reply.user_disliked ? 'active-dislike' : '' %>" 
                                                onclick="toggleCommentReaction(<%= reply.id %>, 'dislike')">
                                            <i class="fas fa-thumbs-down"></i> 
                                            <span class="reaction-count" id="dislike-count-<%= reply.id %>"><%= reply.dislikes || 0 %></span>
                                        </button>
                                        
                                        <% if (reply.user_id === user.id) { %>
                                            <button class="reaction-btn" onclick="showEditForm(<%= reply.id %>, `<%= reply.comment.replace(/'/g, "\\'").replace(/"/g, '&quot;') %>`)">
                                                <i class="fas fa-edit"></i> Edit
                                            </button>
                                            <button class="reaction-btn text-danger" onclick="deleteComment(<%= reply.id %>)">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        <% } else { %>
                                            <button class="reaction-btn text-danger" onclick="showReportModal(<%= reply.id %>)">
                                                <i class="fas fa-flag"></i> Report
                                            </button>
                                        <% } %>
                                    </div>

                                    <!-- Edit Form for Reply (Hidden by default) -->
                                    <div class="edit-form mt-3" id="editForm-<%= reply.id %>" style="display: none;">
                                        <form class="edit-form-inner" onsubmit="submitEdit(event, <%= reply.id %>)">
                                            <div class="mb-2">
                                                <textarea class="form-control form-control-sm" name="edit_comment" rows="2" required 
                                                          id="edit-textarea-<%= reply.id %>"></textarea>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                                                <button type="button" class="btn btn-secondary btn-sm" 
                                                        onclick="document.getElementById('editForm-<%= reply.id %>').style.display = 'none'">
                                                    Cancel
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            <% }) %>
        <% } else { %>
            <div class="text-center py-4">
                <i class="fas fa-comments fa-3x text-muted mb-3"></i>
                <p class="text-muted">No comments yet. Be the first to comment!</p>
            </div>
        <% } %>
    </div>
</div>
</div>

            <!-- Sidebar Actions -->
            <div class="col-lg-4">
                <!-- Event Status & Actions -->
                <div class="action-card">
                    <h5 class="fw-bold mb-3">Event Status</h5>
                    <% 
                        const now = new Date();
                        const start = new Date(event.start_date_time);
                        const end = new Date(event.end_date_time);
                        let status = 'upcoming';
                        let statusText = 'Upcoming';
                        let statusClass = 'bg-primary';
                        
                        if (now >= start && now <= end) {
                            status = 'inprogress';
                            statusText = 'Live Now';
                            statusClass = 'bg-danger';
                        } else if (now > end) {
                            status = 'ended';
                            statusText = 'Ended';
                            statusClass = 'bg-secondary';
                        }
                    %>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="badge <%= statusClass %> fs-6">
                            <i class="fas <%= status === 'inprogress' ? 'fa-play-circle' : status === 'upcoming' ? 'fa-clock' : 'fa-check' %> me-1"></i>
                            <%= statusText %>
                        </span>
                        <span class="badge bg-dark">
                            <i class="fas fa-users me-1"></i><%= event.attendees_count || 0 %>
                        </span>
                    </div>

                    <!-- Action Buttons -->
                    <% if (status === 'ended') { %>
                         <a href="/user/event/<%= event.id %>/photos" class="btn btn-primary w-100 mb-2">
        <i class="fas fa-images me-2"></i>View Photo Wall
    </a>
                    <% } else if (event.user_has_ticket) { %>
                        <button class="btn btn-success w-100 mb-2" disabled>
                            <i class="fas fa-check me-2"></i>Ticket Reserved
                        </button>
                        <small class="text-muted d-block text-center">Your ticket is being processed</small>
                    <% } else { %>
                        <form method="POST" action="/user/event/<%= event.id %>/buy-ticket" class="mb-3">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-ticket-alt me-2"></i>
                                <%= event.entrance_fee > 0 ? `Buy Ticket - $${parseFloat(event.entrance_fee).toFixed(2)}` : 'Get Free Ticket' %>
                            </button>
                        </form>
                    <% } %>

                    <!-- Volunteer Application -->
                    <% if (status === 'upcoming' && event.volunteers_allowed && !event.user_is_volunteer) { %>
                        <hr>
                        <h6 class="fw-bold mb-3">Interested in Volunteering?</h6>
                        <button type="button" class="btn btn-outline-primary w-100" data-bs-toggle="modal" data-bs-target="#volunteerModal">
                            <i class="fas fa-hands-helping me-2"></i>Apply to Volunteer
                        </button>
                    <% } else if (event.user_is_volunteer) { %>
                        <hr>
                        <div class="alert alert-info">
                            <i class="fas fa-check-circle me-2"></i>
                            <strong>Volunteer Application Submitted</strong>
                            <small class="d-block mt-1">Your application is under review</small>
                        </div>
                    <% } %>
                </div>

                <!-- Event Quick Info -->
                <div class="action-card">
                    <h5 class="fw-bold mb-3">Quick Info</h5>
                    <div class="mb-3">
                        <strong>Date:</strong><br>
                        <span class="text-muted"><%= new Date(event.start_date_time).toLocaleDateString() %></span>
                    </div>
                    <div class="mb-3">
                        <strong>Time:</strong><br>
                        <span class="text-muted">
                            <%= new Date(event.start_date_time).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %> - 
                            <%= new Date(event.end_date_time).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                        </span>
                    </div>
                    <div class="mb-3">
                        <strong>Venue:</strong><br>
                        <span class="text-muted"><%= event.venue || 'TBA' %></span>
                    </div>
                    <div>
                        <strong>Entry:</strong><br>
                        <span class="text-muted"><%= event.entrance_fee > 0 ? `$${parseFloat(event.entrance_fee).toFixed(2)}` : 'Free' %></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Volunteer Application Modal -->
    <div class="modal fade" id="volunteerModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Apply to Volunteer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="POST" action="/user/event/<%= event.id %>/volunteer">
                    <div class="modal-body">
                        <p>Help make this event a success! Tell us why you'd like to volunteer and what role you're interested in.</p>
                        <div class="mb-3">
                            <label for="role" class="form-label">Preferred Role</label>
                            <input type="text" class="form-control" id="role" name="role" 
                                   placeholder="e.g., Registration, Usher, Technical Support" required>
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label">Why do you want to volunteer?</label>
                            <textarea class="form-control" id="description" name="description" rows="4" 
                                      placeholder="Tell us about your interest and any relevant experience..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Submit Application</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Report Comment Modal -->
    <div class="modal fade" id="reportModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Report Comment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="reportForm">
                    <div class="modal-body">
                        <p>Help us keep the community safe by reporting inappropriate content.</p>
                        <div class="mb-3">
                            <label for="report_type" class="form-label">Report Type</label>
                            <select class="form-select" id="report_type" name="report_type" required>
                                <option value="inappropriate">Inappropriate Content</option>
                                <option value="harassment">Harassment or Bullying</option>
                                <option value="spam">Spam or Advertisement</option>
                                <option value="hate_speech">Hate Speech</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="report_reason" class="form-label">Reason for Report</label>
                            <textarea class="form-control" id="report_reason" name="report_reason" rows="4" 
                                      placeholder="Please provide specific details about why you are reporting this comment..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Submit Report</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Event Like Functionality
    async function toggleEventLike(eventId) {
        const likeBtn = document.querySelector('.like-btn');
        const likeCount = likeBtn.querySelector('.like-count');
        
        try {
            const response = await fetch(`/user/event/${eventId}/like`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            });
            
            const result = await response.json();
            
            if (result.success) {
                likeBtn.classList.toggle('liked');
                likeCount.textContent = result.likesCount;
                
                // Add animation effect
                likeBtn.style.transform = 'scale(1.3)';
                setTimeout(() => {
                    likeBtn.style.transform = 'scale(1)';
                }, 300);
            }
        } catch (error) {
            console.error('Error toggling like:', error);
            showAlert('Error liking event', 'danger');
        }
    }

    // Add Comment Functionality
    document.getElementById('addCommentForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(e.target);
        const comment = formData.get('comment');
        
        if (!comment.trim()) return;
        
        try {
            const response = await fetch('/user/comment', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    event_id: <%= event.id %>,
                    comment: comment
                })
            });
            
            const result = await response.json();
            
            if (result.success) {
                // Add new comment to the list
                const commentsList = document.getElementById('commentsList');
                const newCommentHtml = createCommentHtml(result.comment, 0);
                commentsList.insertAdjacentHTML('afterbegin', newCommentHtml);
                
                // Update comments count
                const commentsCount = document.getElementById('commentsCount');
                commentsCount.textContent = parseInt(commentsCount.textContent) + 1;
                
                // Clear form
                e.target.reset();
                
                // Show success message
                showAlert('Comment posted successfully!', 'success');
            } else {
                showAlert(result.error, 'danger');
            }
        } catch (error) {
            console.error('Error posting comment:', error);
            showAlert('Error posting comment', 'danger');
        }
    });

    // Comment Reaction Functionality
    async function toggleCommentReaction(commentId, reactionType) {
        const likeBtn = document.querySelector(`#comment-${commentId} .reaction-btn:nth-child(1)`);
        const dislikeBtn = document.querySelector(`#comment-${commentId} .reaction-btn:nth-child(2)`);
        const likeCount = document.getElementById(`like-count-${commentId}`);
        const dislikeCount = document.getElementById(`dislike-count-${commentId}`);
        
        try {
            const response = await fetch(`/user/comment/${commentId}/react`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    reaction_type: reactionType
                })
            });
            
            const result = await response.json();
            
            if (result.success) {
                // Update counts
                likeCount.textContent = result.likes;
                dislikeCount.textContent = result.dislikes;
                
                // Update button states
                if (reactionType === 'like') {
                    likeBtn.classList.toggle('active-like');
                    if (dislikeBtn.classList.contains('active-dislike')) {
                        dislikeBtn.classList.remove('active-dislike');
                    }
                } else {
                    dislikeBtn.classList.toggle('active-dislike');
                    if (likeBtn.classList.contains('active-like')) {
                        likeBtn.classList.remove('active-like');
                    }
                }
            }
        } catch (error) {
            console.error('Error toggling reaction:', error);
            showAlert('Error reacting to comment', 'danger');
        }
    }

    // Show Reply Form
    function showReplyForm(commentId) {
        const replyForm = document.getElementById(`replyForm-${commentId}`);
        replyForm.style.display = replyForm.style.display === 'none' ? 'block' : 'none';
    }

    // Submit Reply
    async function submitReply(event, parentCommentId) {
        event.preventDefault();
        
        const form = event.target;
        const replyText = form.reply.value;
        
        if (!replyText.trim()) return;
        
        try {
            const response = await fetch('/user/comment', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    event_id: <%= event.id %>,
                    comment: replyText,
                    parent_comment: parentCommentId
                })
            });
            
            const result = await response.json();
            
            if (result.success) {
                // Add reply to the comments list
                const commentElement = document.getElementById(`comment-${parentCommentId}`);
                const repliesContainer = commentElement.querySelector('.replies') || createRepliesContainer(commentElement);
                
                const replyHtml = createCommentHtml(result.comment, 1);
                repliesContainer.insertAdjacentHTML('beforeend', replyHtml);
                
                // Update comments count
                const commentsCount = document.getElementById('commentsCount');
                commentsCount.textContent = parseInt(commentsCount.textContent) + 1;
                
                // Clear and hide form
                form.reset();
                document.getElementById(`replyForm-${parentCommentId}`).style.display = 'none';
                
                showAlert('Reply posted successfully!', 'success');
            } else {
                showAlert(result.error, 'danger');
            }
        } catch (error) {
            console.error('Error posting reply:', error);
            showAlert('Error posting reply', 'danger');
        }
    }

    // Create replies container if it doesn't exist
    function createRepliesContainer(commentElement) {
        const repliesDiv = document.createElement('div');
        repliesDiv.className = 'replies mt-3';
        commentElement.appendChild(repliesDiv);
        return repliesDiv;
    }

    // Show Edit Form
    function showEditForm(commentId, currentText) {
        const editForm = document.getElementById(`editForm-${commentId}`);
        const textarea = document.getElementById(`edit-textarea-${commentId}`);
        textarea.value = currentText;
        editForm.style.display = editForm.style.display === 'none' ? 'block' : 'none';
    }

    // Submit Edit
    async function submitEdit(event, commentId) {
        event.preventDefault();
        
        const form = event.target;
        const newText = form.edit_comment.value;
        
        if (!newText.trim()) return;
        
        try {
            const response = await fetch(`/user/comment/${commentId}/edit`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    comment: newText
                })
            });
            
            const result = await response.json();
            
            if (result.success) {
                // Update comment text
                document.getElementById(`comment-text-${commentId}`).textContent = newText;
                
                // Hide edit form
                document.getElementById(`editForm-${commentId}`).style.display = 'none';
                
                showAlert('Comment updated successfully!', 'success');
            } else {
                showAlert(result.error, 'danger');
            }
        } catch (error) {
            console.error('Error editing comment:', error);
            showAlert('Error updating comment', 'danger');
        }
    }

    // Delete Comment
    async function deleteComment(commentId) {
        if (!confirm('Are you sure you want to delete this comment?')) return;
        
        try {
            const response = await fetch(`/user/comment/${commentId}`, {
                method: 'DELETE'
            });
            
            const result = await response.json();
            
            if (result.success) {
                // Remove comment from DOM
                document.getElementById(`comment-${commentId}`).remove();
                
                // Update comments count
                const commentsCount = document.getElementById('commentsCount');
                commentsCount.textContent = parseInt(commentsCount.textContent) - 1;
                
                showAlert('Comment deleted successfully!', 'success');
            } else {
                showAlert(result.error, 'danger');
            }
        } catch (error) {
            console.error('Error deleting comment:', error);
            showAlert('Error deleting comment', 'danger');
        }
    }

    // Report Comment
    let currentReportCommentId = null;

    function showReportModal(commentId) {
        currentReportCommentId = commentId;
        const reportModal = new bootstrap.Modal(document.getElementById('reportModal'));
        reportModal.show();
    }

    document.getElementById('reportForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        if (!currentReportCommentId) return;
        
        const formData = new FormData(e.target);
        const reportType = formData.get('report_type');
        const reportReason = formData.get('report_reason');
        
        try {
            const response = await fetch(`/user/comment/${currentReportCommentId}/report`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    report_type: reportType,
                    report_reason: reportReason
                })
            });
            
            const result = await response.json();
            
            if (result.success) {
                const reportModal = bootstrap.Modal.getInstance(document.getElementById('reportModal'));
                reportModal.hide();
                e.target.reset();
                showAlert('Comment reported successfully!', 'success');
            } else {
                showAlert(result.error, 'danger');
            }
        } catch (error) {
            console.error('Error reporting comment:', error);
            showAlert('Error reporting comment', 'danger');
        }
    });

    // Utility Functions
    function showAlert(message, type) {
        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
        alertDiv.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.querySelector('.container').insertBefore(alertDiv, document.querySelector('.container').firstChild);
        
        setTimeout(() => {
            if (alertDiv.parentNode) {
                alertDiv.remove();
            }
        }, 5000);
    }

    function createCommentHtml(comment, level) {
        const isReply = level > 0;
        const escapedComment = comment.comment.replace(/</g, '&lt;').replace(/>/g, '&gt;');
        
        return `
            <div class="${isReply ? 'reply-card' : 'comment-card'}" id="comment-${comment.id}">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <strong>${comment.first_name} ${comment.last_name}</strong>
                        <small class="text-muted ms-2">@${comment.identifier}</small>
                    </div>
                    <small class="text-muted">${new Date(comment.created_at).toLocaleString()}</small>
                </div>
                <p class="mb-2" id="comment-text-${comment.id}">${escapedComment}</p>
                
                <div class="comment-actions d-flex gap-2 align-items-center">
                    <button class="reaction-btn" onclick="toggleCommentReaction(${comment.id}, 'like')">
                        <i class="fas fa-thumbs-up"></i> 
                        <span class="reaction-count" id="like-count-${comment.id}">0</span>
                    </button>
                    
                    <button class="reaction-btn" onclick="toggleCommentReaction(${comment.id}, 'dislike')">
                        <i class="fas fa-thumbs-down"></i> 
                        <span class="reaction-count" id="dislike-count-${comment.id}">0</span>
                    </button>
                    
                    ${!isReply ? `
                        <button class="reaction-btn" onclick="showReplyForm(${comment.id})">
                            <i class="fas fa-reply"></i> Reply
                        </button>
                    ` : ''}
                    
                    ${comment.user_id === <%= user.id %> ? `
                        <button class="reaction-btn" onclick="showEditForm(${comment.id}, \`${escapedComment}\`)">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button class="reaction-btn text-danger" onclick="deleteComment(${comment.id})">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    ` : `
                        <button class="reaction-btn text-danger" onclick="showReportModal(${comment.id})">
                            <i class="fas fa-flag"></i> Report
                        </button>
                    `}
                </div>

                ${!isReply ? `
                    <div class="reply-form mt-3" id="replyForm-${comment.id}" style="display: none;">
                        <form class="reply-form-inner" onsubmit="submitReply(event, ${comment.id})">
                            <div class="mb-2">
                                <textarea class="form-control form-control-sm" name="reply" rows="2" 
                                          placeholder="Write a reply..." required></textarea>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary btn-sm">Post Reply</button>
                                <button type="button" class="btn btn-secondary btn-sm" 
                                        onclick="document.getElementById('replyForm-${comment.id}').style.display = 'none'">
                                    Cancel
                                </button>
                            </div>
                        </form>
                    </div>
                ` : ''}

                <div class="edit-form mt-3" id="editForm-${comment.id}" style="display: none;">
                    <form class="edit-form-inner" onsubmit="submitEdit(event, ${comment.id})">
                        <div class="mb-2">
                            <textarea class="form-control form-control-sm" name="edit_comment" rows="${isReply ? 2 : 3}" required 
                                      id="edit-textarea-${comment.id}"></textarea>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                            <button type="button" class="btn btn-secondary btn-sm" 
                                    onclick="document.getElementById('editForm-${comment.id}').style.display = 'none'">
                                Cancel
                            </button>
                        </div>
                    </form>
                </div>

                ${!isReply ? '<div class="replies mt-3"></div>' : ''}
            </div>
        `;
    }
</script>
</body>
</html>