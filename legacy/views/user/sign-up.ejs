<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Sign-Up</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/include/css/style.css" />
    <style>
      .password-toggle {
        cursor: pointer;
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
      }
      .password-container {
        position: relative;
      }
    </style>
  </head>
  <body>
    <div class="d-flex justify-content-center align-items-center vh-100">
      <form method="POST" class="lg card col-lg-5 col-md-10 col-sm-10 p-5 mx-3">
        <div class="d-flex justify-content-center">
          <img src="/include/images/logo.png" alt="logo" class="lg logo-img" />
        </div>
        <div class="d-flex justify-content-center">
          <h1 class="mb-4">STUDENT SIGN-UP</h1>
        </div>
        
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>
        
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>
        
        <div class="d-flex justify-content-between">
          <div class="me-2" style="width: 48%">
            <label for="first_name" class="lg form-label mb-0">First Name:</label>
            <input type="text" class="lg form-control mb-3" id="first_name" name="first_name" 
                   value="<%= typeof formData !== 'undefined' ? formData.first_name : '' %>" required />
          </div>
          <div style="width: 48%">
            <label for="last_name" class="lg form-label mb-0">Last Name:</label>
            <input type="text" class="lg form-control mb-3" id="last_name" name="last_name" 
                   value="<%= typeof formData !== 'undefined' ? formData.last_name : '' %>" required />
          </div>
        </div>
        
        <label for="identifier" class="lg form-label mb-0">Student ID:</label>
        <input type="text" class="lg form-control mb-3" id="identifier" name="identifier" 
               placeholder="Enter your 9-digit student ID"
               maxlength="9"
               pattern="\d{9}"
               title="Student ID must be exactly 9 digits"
               value="<%= typeof formData !== 'undefined' ? formData.identifier : '' %>" required />
        
        <label for="password" class="lg form-label mb-0">Password:</label>
        <div class="password-container mb-3">
          <input type="password" class="lg form-control" id="password" name="password" required />
          <span class="password-toggle" onclick="togglePassword('password')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16" id="eye-icon-password">
              <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
              <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-slash d-none" viewBox="0 0 16 16" id="eye-slash-icon-password">
              <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z"/>
              <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/>
              <path d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12z"/>
            </svg>
          </span>
        </div>
        
        <label for="confirmPassword" class="lg form-label mb-0">Confirm Password:</label>
        <div class="password-container mb-4">
          <input type="password" class="lg form-control" id="confirmPassword" name="confirmPassword" required />
          <span class="password-toggle" onclick="togglePassword('confirmPassword')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16" id="eye-icon-confirmPassword">
              <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
              <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-slash d-none" viewBox="0 0 16 16" id="eye-slash-icon-confirmPassword">
              <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z"/>
              <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/>
              <path d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12z"/>
            </svg>
          </span>
        </div>
        
        <div class="password-requirements mb-3">
          <small>Password must contain at least:</small>
          <ul class="mb-0">
            <li id="length" class="text-danger">8 characters</li>
            <li id="uppercase" class="text-danger">1 uppercase letter</li>
            <li id="lowercase" class="text-danger">1 lowercase letter</li>
            <li id="number" class="text-danger">1 number</li>
            <li id="special" class="text-danger">1 special character</li>
          </ul>
        </div>

        <div class="d-flex justify-content-between">
          <button type="button" class="btn lg btn-secondary rounded-pill col-4 mx-4 mt-3"
                  onclick="window.location.href='/user/login'">
            Back
          </button>
          <button type="submit" class="btn lg btn-outline-success col-4 mx-4 mt-3">
            <i class="fas fa-user-plus me-2"></i>Sign Up
          </button>
        </div>
      </form>
    </div>
    
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
      crossorigin="anonymous"
    ></script>
    
    <script>
      function togglePassword(fieldId) {
        const passwordInput = document.getElementById(fieldId);
        const eyeIcon = document.getElementById(`eye-icon-${fieldId}`);
        const eyeSlashIcon = document.getElementById(`eye-slash-icon-${fieldId}`);
        
        if (passwordInput.type === 'password') {
          passwordInput.type = 'text';
          eyeIcon.classList.add('d-none');
          eyeSlashIcon.classList.remove('d-none');
        } else {
          passwordInput.type = 'password';
          eyeIcon.classList.remove('d-none');
          eyeSlashIcon.classList.add('d-none');
        }
      }
      
      // Password validation
      const passwordInput = document.getElementById('password');
      const confirmPasswordInput = document.getElementById('confirmPassword');
      const requirements = {
        length: document.getElementById('length'),
        uppercase: document.getElementById('uppercase'),
        lowercase: document.getElementById('lowercase'),
        number: document.getElementById('number'),
        special: document.getElementById('special')
      };
      
      passwordInput.addEventListener('input', validatePassword);
      confirmPasswordInput.addEventListener('input', validateConfirmPassword);
      
      function validatePassword() {
        const password = passwordInput.value;
        
        // Check length
        const hasLength = password.length >= 8;
        requirements.length.classList.toggle('text-success', hasLength);
        requirements.length.classList.toggle('text-danger', !hasLength);
        
        // Check uppercase
        const hasUppercase = /[A-Z]/.test(password);
        requirements.uppercase.classList.toggle('text-success', hasUppercase);
        requirements.uppercase.classList.toggle('text-danger', !hasUppercase);
        
        // Check lowercase
        const hasLowercase = /[a-z]/.test(password);
        requirements.lowercase.classList.toggle('text-success', hasLowercase);
        requirements.lowercase.classList.toggle('text-danger', !hasLowercase);
        
        // Check number
        const hasNumber = /[0-9]/.test(password);
        requirements.number.classList.toggle('text-success', hasNumber);
        requirements.number.classList.toggle('text-danger', !hasNumber);
        
        // Check special character
        const hasSpecial = /[!@#$%^&*(),.?":{}|<>]/.test(password);
        requirements.special.classList.toggle('text-success', hasSpecial);
        requirements.special.classList.toggle('text-danger', !hasSpecial);
      }
      
      function validateConfirmPassword() {
        const password = passwordInput.value;
        const confirmPassword = confirmPasswordInput.value;
        
        if (confirmPassword && password !== confirmPassword) {
          confirmPasswordInput.setCustomValidity("Passwords don't match");
        } else {
          confirmPasswordInput.setCustomValidity('');
        }
      }
      
      // Form validation
      document.querySelector('form').addEventListener('submit', function(e) {
        const password = passwordInput.value;
        
        // Check if password meets all requirements
        const hasLength = password.length >= 8;
        const hasUppercase = /[A-Z]/.test(password);
        const hasLowercase = /[a-z]/.test(password);
        const hasNumber = /[0-9]/.test(password);
        const hasSpecial = /[!@#$%^&*(),.?":{}|<>]/.test(password);
        
        if (!hasLength || !hasUppercase || !hasLowercase || !hasNumber || !hasSpecial) {
          e.preventDefault();
          alert('Please make sure your password meets all the requirements.');
          return false;
        }
        
        // Validate student ID format
        const studentIdPattern = /^\d{9}$/;
        const identifier = document.getElementById('identifier').value;
        if (!studentIdPattern.test(identifier)) {
          e.preventDefault();
          alert('Please enter a valid 9-digit student ID');
          return false;
        }
        
        return true;
      });
      
      // Validate student ID input - only allow numbers
      document.getElementById('identifier').addEventListener('input', function(e) {
        this.value = this.value.replace(/[^0-9]/g, '');
      });
    </script>
  </body>
</html>