<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Sign-Up</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/include/css/style.css" />
  </head>
  <body>
    <div class="d-flex justify-content-center align-items-center vh-100">
      <form action="/admin/signup" method="POST" class="lg card col-lg-5 col-md-10 col-sm-10 p-5 mx-3">
        <div class="d-flex justify-content-center">
          <img src="/include/images/logo.png" alt="logo" class="lg logo-img" />
        </div>
        <div class="d-flex justify-content-center">
          <h1 class="mb-4">ADMIN SIGN-UP</h1>
        </div>
        
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger" role="alert">
            <%= error %>
          </div>
        <% } %>
        
        <div class="d-flex justify-content-between">
          <div class="me-2" style="width: 48%">
            <label for="firstName" class="lg form-label mb-0">First Name:</label>
            <input type="text" class="lg form-control mb-3" id="firstName" name="first_name" 
                   value="<%= typeof formData !== 'undefined' ? formData.first_name : '' %>" required />
          </div>
          <div style="width: 48%">
            <label for="lastName" class="lg form-label mb-0">Last Name:</label>
            <input type="text" class="lg form-control mb-3" id="lastName" name="last_name" 
                   value="<%= typeof formData !== 'undefined' ? formData.last_name : '' %>" required />
          </div>
        </div>
        
        <label for="identifier" class="lg form-label mb-0">Staff Number:</label>
        <input type="text" class="lg form-control mb-3" id="identifier" name="identifier" 
               pattern="[0-9]{9}" title="Staff number must be exactly 8 digits" 
               value="<%= typeof formData !== 'undefined' ? formData.identifier : '' %>" required />
        
        <label for="password" class="lg form-label mb-0">Password:</label>
        <input type="password" class="lg form-control mb-3" id="password" name="password" required />
        
        <label for="confirmPassword" class="lg form-label mb-0">Confirm Password:</label>
        <input type="password" class="lg form-control mb-4" id="confirmPassword" name="confirmPassword" required />
        
        <div class="password-requirements mb-3">
          <small>Password must contain at least:</small>
          <ul class="mb-0">
            <li id="length" class="text-danger">8 characters</li>
            <li id="uppercase" class="text-danger">1 uppercase letter</li>
            <li id="lowercase" class="text-danger">1 lowercase letter</li>
            <li id="number" class="text-danger">1 number</li>
            <li id="special" class="text-danger">1 special character</li>
          </ul>
        </div>

        <div class="d-flex justify-content-between">
          <button type="button" class="btn lg btn-secondary rounded-pill col-4 mx-4 mt-3"
                  onclick="window.location.href='/admin/login'">
            Back
          </button>
          <button type="submit" class="btn lg btn-outline-success col-4 mx-4 mt-3">
            Sign Up
          </button>
        </div>
      </form>
    </div>
    
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
      crossorigin="anonymous"
    ></script>
    
    <script>
      // Password validation
      const passwordInput = document.getElementById('password');
      const confirmPasswordInput = document.getElementById('confirmPassword');
      const requirements = {
        length: document.getElementById('length'),
        uppercase: document.getElementById('uppercase'),
        lowercase: document.getElementById('lowercase'),
        number: document.getElementById('number'),
        special: document.getElementById('special')
      };
      
      passwordInput.addEventListener('input', validatePassword);
      confirmPasswordInput.addEventListener('input', validateConfirmPassword);
      
      function validatePassword() {
        const password = passwordInput.value;
        
        // Check length
        const hasLength = password.length >= 9;
        requirements.length.classList.toggle('text-success', hasLength);
        requirements.length.classList.toggle('text-danger', !hasLength);
        
        // Check uppercase
        const hasUppercase = /[A-Z]/.test(password);
        requirements.uppercase.classList.toggle('text-success', hasUppercase);
        requirements.uppercase.classList.toggle('text-danger', !hasUppercase);
        
        // Check lowercase
        const hasLowercase = /[a-z]/.test(password);
        requirements.lowercase.classList.toggle('text-success', hasLowercase);
        requirements.lowercase.classList.toggle('text-danger', !hasLowercase);
        
        // Check number
        const hasNumber = /[0-9]/.test(password);
        requirements.number.classList.toggle('text-success', hasNumber);
        requirements.number.classList.toggle('text-danger', !hasNumber);
        
        // Check special character
        const hasSpecial = /[!@#$%^&*(),.?":{}|<>]/.test(password);
        requirements.special.classList.toggle('text-success', hasSpecial);
        requirements.special.classList.toggle('text-danger', !hasSpecial);
      }
      
      function validateConfirmPassword() {
        const password = passwordInput.value;
        const confirmPassword = confirmPasswordInput.value;
        
        if (confirmPassword && password !== confirmPassword) {
          confirmPasswordInput.setCustomValidity("Passwords don't match");
        } else {
          confirmPasswordInput.setCustomValidity('');
        }
      }
      
      // Form validation
      document.querySelector('form').addEventListener('submit', function(e) {
        const password = passwordInput.value;
        
        // Check if password meets all requirements
        const hasLength = password.length >= 9;
        const hasUppercase = /[A-Z]/.test(password);
        const hasLowercase = /[a-z]/.test(password);
        const hasNumber = /[0-9]/.test(password);
        const hasSpecial = /[!@#$%^&*(),.?":{}|<>]/.test(password);
        
        if (!hasLength || !hasUppercase || !hasLowercase || !hasNumber || !hasSpecial) {
          e.preventDefault();
          alert('Please make sure your password meets all the requirements.');
        }
      });
    </script>
  </body>
</html>